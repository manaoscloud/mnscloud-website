---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
import { formatPostDate, getBlogPosts } from '../../lib/blog';
import pages from '../../content/site/pages.json';

export function getStaticPaths() {
  return getBlogPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const Content = post.Content;
const page = pages.blog;
---

<BaseLayout title={`${post.frontmatter.title} - ${page.title.replace(/^Blog - /, '')}`} description={post.frontmatter.description}>
  <Header />
  <main>
    <article class="section">
      <div class="container article-layout">
        <a class="back-link" href="/blog">{page.backLabel}</a>
        <header>
          <span class="eyebrow">{page.articleEyebrow}</span>
          <h1>{post.frontmatter.title}</h1>
          <p>{post.frontmatter.description}</p>
          <div class="post-meta">
            <span>{formatPostDate(post.frontmatter.date)}</span>
            <span>{post.frontmatter.author}</span>
          </div>
        </header>
        <div class="article-body">
          <Content />
        </div>
      </div>
    </article>
    <CTA title={page.articleCtaTitle} />
  </main>
  <Footer />
</BaseLayout>

<style>
  .article-layout {
    max-width: 860px;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 28px;
    color: var(--accent);
    font-weight: 850;
  }

  h1 {
    margin: 12px 0 18px;
    font-size: clamp(2.7rem, 7vw, 5.4rem);
    line-height: 0.98;
  }

  header p {
    margin: 0;
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.75;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: 22px;
    color: var(--muted);
    font-size: 0.92rem;
    font-weight: 750;
  }

  .article-body {
    margin-top: 44px;
    border-top: 1px solid var(--line);
    padding-top: 34px;
    color: var(--text);
    font-size: 1.06rem;
    line-height: 1.85;
  }

  .article-body :global(p) {
    margin: 0 0 22px;
  }

  .article-body :global(a) {
    color: var(--accent);
    font-weight: 800;
  }
</style>
