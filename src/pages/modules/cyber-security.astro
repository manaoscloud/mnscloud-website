---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
---

<BaseLayout title="Cyber Security - MNSCloud">
  <Header />
  <main class="module-page">
    <section class="section">
      <div class="container detail-grid">
        <div>
          <span class="eyebrow">Security Operations</span>
          <h1>Cyber Security</h1>
          <p class="lead">
            Service-based protection profiles, CrowdSec intelligence, nftables enforcement, alerts,
            decisions, allowlists, blocklists, and agent-driven installation.
          </p>
        </div>
        <div class="card detail-card">
          <h2>Security Principles</h2>
          <ul>
            <li>Profiles are based on services such as SSH, Nginx, Asterisk, Kamailio, and MariaDB.</li>
            <li>Firewall enforcement uses nftables with CrowdSec decisions.</li>
            <li>Agents report status and job history back to the platform.</li>
            <li>Public installers do not hold customer secrets or private policy authority.</li>
          </ul>
        </div>
      </div>
    </section>
    <CTA title="Build security posture from services, not from fragile server labels." />
  </main>
  <Footer />
</BaseLayout>

<style>
  h1 {
    margin: 12px 0 18px;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.95;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 34px;
    align-items: start;
  }

  .detail-card {
    padding: 28px;
  }

  li {
    margin-bottom: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
