---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTA from '../../components/CTA.astro';
---

<BaseLayout title="VoIP Platform - MNSCloud">
  <Header />
  <main class="module-page">
    <section class="section">
      <div class="container detail-grid">
        <div>
          <span class="eyebrow">Telecom Core</span>
          <h1>VoIP Platform</h1>
          <p class="lead">
            Manage PABX, Softswitch, DID inventory, routing, recordings, media files, and WebRTC
            readiness through a multi-tenant API-first architecture.
          </p>
        </div>
        <div class="card detail-card">
          <h2>Primary Areas</h2>
          <ul>
            <li>PABX servers, accounts, trunks, routing, queues, IVR, and media files.</li>
            <li>Softswitch providers, resources, subscribers, DID, and routing.</li>
            <li>SBC and WebRTC edge architecture for secure registration.</li>
            <li>Storage-backed recordings and public client integrations.</li>
          </ul>
        </div>
      </div>
    </section>
    <CTA title="Enable voice operations without exposing private control-plane logic." />
  </main>
  <Footer />
</BaseLayout>

<style>
  .module-page h1 {
    margin: 12px 0 18px;
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.95;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 34px;
    align-items: start;
  }

  .detail-card {
    padding: 28px;
  }

  .detail-card h2 {
    margin: 0 0 16px;
  }

  li {
    margin-bottom: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
