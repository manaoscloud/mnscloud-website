---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import legal from '../../content/site/legal.json';

const legalPages = {
  privacy: legal.pages.privacy,
  cookies: legal.pages.cookies,
  terms: legal.pages.terms,
  'data-processing': legal.pages.dataProcessing,
  subprocessors: legal.pages.subprocessors,
};

export function getStaticPaths() {
  return ['privacy', 'cookies', 'terms', 'data-processing', 'subprocessors'].map((slug) => ({
    params: { slug },
  }));
}

const slug = Astro.params.slug as keyof typeof legalPages;
const page = legalPages[slug];
---

<BaseLayout title={page.title} description={page.description}>
  <Header />
  <main>
    <article class="section">
      <div class="container legal-layout">
        <a class="back-link" href="/trust">Trust Center</a>
        <header>
          <span class="eyebrow">{page.eyebrow}</span>
          <h1>{page.heading}</h1>
          <p class="effective-date">{page.effectiveDate}</p>
          <p class="lead">{page.lead}</p>
        </header>

        <div class="legal-sections">
          {page.sections.map((section) => (
            <section class="card legal-section">
              <h2>{section.title}</h2>
              <p>{section.body}</p>
            </section>
          ))}
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-layout {
    max-width: 920px;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 28px;
    color: var(--accent);
    font-weight: 850;
  }

  h1 {
    margin: 12px 0 12px;
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    line-height: 0.98;
  }

  .effective-date {
    margin: 0 0 18px;
    color: var(--accent);
    font-weight: 800;
  }

  .legal-sections {
    display: grid;
    gap: 14px;
    margin-top: 36px;
  }

  .legal-section {
    padding: 22px;
  }

  .legal-section h2 {
    margin: 0 0 10px;
    font-size: 1.45rem;
  }

  .legal-section p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  @media (max-width: 520px) {
    .legal-section {
      padding: 18px;
    }
  }
</style>
