---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ModuleCard from '../components/ModuleCard.astro';
import CTA from '../components/CTA.astro';
import { productModules } from '../data/modules';
import { formatPostDate, getBlogPosts } from '../lib/blog';
import home from '../content/site/home.json';
import settings from '../content/site/settings.json';

const latestPosts = getBlogPosts().slice(0, 2);
---

<BaseLayout title={home.seoTitle} description={home.seoDescription}>
  <Header />
  <main>
    <section class="hero">
      <img class="brand-watermark" src={settings.brand.watermark} alt="" />
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">{home.hero.eyebrow}</span>
          <img class="hero-logo" src={settings.brand.logoLight} alt={settings.brand.heroAlt} />
          <p>
            {home.hero.text}
          </p>
          <div class="hero-actions">
            <a class="button primary" href={home.hero.primaryAction.href}>{home.hero.primaryAction.label}</a>
            <a class="button" href={home.hero.secondaryAction.href}>{home.hero.secondaryAction.label}</a>
          </div>
        </div>
        <div class="hero-panel card" aria-label="Platform overview">
          {
            home.hero.panelRows.map((row) => (
              <div class="panel-row">
                <span>{row.label}</span>
                <strong>{row.value}</strong>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section id="modules" class="section">
      <div class="container">
        <div class="section-title">
          <span class="eyebrow">{home.modulesSection.eyebrow}</span>
          <h2>{home.modulesSection.title}</h2>
          <p>
            {home.modulesSection.text}
          </p>
        </div>
        <div class="grid three">
          {productModules.map((module) => <ModuleCard module={module} />)}
        </div>
      </div>
    </section>

    <section class="section platform-band">
      <div class="container band-grid">
        <div>
          <span class="eyebrow">{home.architectureBand.eyebrow}</span>
          <h2>{home.architectureBand.title}</h2>
        </div>
        <p>
          {home.architectureBand.text}
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-title">
          <span class="eyebrow">{home.blogSection.eyebrow}</span>
          <h2>{home.blogSection.title}</h2>
          <p>
            {home.blogSection.text}
          </p>
        </div>
        <div class="grid three latest-posts">
          {
            latestPosts.map((post) => (
              <article class="card latest-card">
                <span>{formatPostDate(post.frontmatter.date)}</span>
                <h3>
                  <a href={`/blog/${post.slug}`}>{post.frontmatter.title}</a>
                </h3>
                <p>{post.frontmatter.description}</p>
              </article>
            ))
          }
          <a class="card latest-card all-posts" href="/blog">
            <span>Content hub</span>
            <h3>{home.blogSection.allPostsTitle}</h3>
            <p>{home.blogSection.allPostsText}</p>
          </a>
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: 720px;
    display: grid;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    gap: 36px;
    align-items: center;
    padding: 80px 0;
  }

  .hero-logo {
    width: min(620px, 100%);
    height: auto;
    margin: 18px 0 24px;
  }

  .hero-copy p {
    max-width: 780px;
    color: var(--muted);
    font-size: clamp(1.08rem, 2vw, 1.35rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .hero-panel {
    padding: 16px;
  }

  .panel-row {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    padding: 18px;
    border-bottom: 1px solid var(--line);
  }

  .panel-row:last-child {
    border-bottom: 0;
  }

  .panel-row span {
    color: var(--muted);
  }

  .panel-row strong {
    text-align: right;
  }

  .platform-band {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: rgba(45, 245, 224, 0.04);
  }

  .band-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 34px;
    align-items: start;
  }

  .band-grid h2 {
    margin: 10px 0 0;
    font-family: Oswald, Montserrat, sans-serif;
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1;
  }

  .band-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.8;
  }

  .latest-posts {
    align-items: stretch;
  }

  .latest-card {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 22px;
  }

  .latest-card span {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 850;
  }

  .latest-card h3 {
    margin: 0;
    font-size: 1.55rem;
    line-height: 1.12;
  }

  .latest-card h3 a:hover,
  .all-posts:hover h3 {
    color: var(--accent);
  }

  .latest-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: auto;
    }

    .hero-grid,
    .band-grid {
      grid-template-columns: 1fr;
    }

    .hero-grid {
      padding: 54px 0;
    }
  }
</style>
