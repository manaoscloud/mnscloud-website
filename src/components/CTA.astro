---
import settings from '../content/site/settings.json';

type Props = {
  title?: string;
  text?: string;
};

const {
  title = settings.globalCta.title,
  text = settings.globalCta.text,
} = Astro.props;
---

<section class="cta-section">
  <div class="container cta card">
    <div>
      <span class="eyebrow">{settings.globalCta.eyebrow}</span>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="button primary" href={settings.globalCta.buttonHref}>{settings.globalCta.buttonLabel}</a>
  </div>
</section>

<style>
  .cta-section {
    padding: 40px 0 90px;
  }

  .cta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 34px;
    background:
      linear-gradient(135deg, rgba(45, 245, 224, 0.12), transparent 46%),
      rgba(15, 29, 26, 0.9);
  }

  h2 {
    margin: 10px 0 10px;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1;
  }

  p {
    max-width: 760px;
    color: var(--muted);
    line-height: 1.7;
  }

  @media (max-width: 780px) {
    .cta {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .cta-section {
      padding: 28px 0 64px;
    }

    .cta {
      padding: 22px;
    }
  }
</style>
