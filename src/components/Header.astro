---
import settings from '../content/site/settings.json';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${settings.site.name} home`}>
      <img src={settings.brand.logoLight} alt="" />
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Open navigation">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav id="site-navigation" aria-label="Main navigation">
      {settings.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="button primary mobile-cta" href={settings.headerCta.href}>{settings.headerCta.label}</a>
    </nav>
    <a class="button primary header-cta" href={settings.headerCta.href}>{settings.headerCta.label}</a>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('#site-navigation');

  const closeMenu = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.setAttribute('data-open', 'false');
  };

  toggle?.addEventListener('click', () => {
    const nextState = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(nextState));
    nav?.setAttribute('data-open', String(nextState));
  });

  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

  window.addEventListener('resize', () => {
    if (window.innerWidth > 820) closeMenu();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--line);
    background: rgba(7, 17, 15, 0.9);
    backdrop-filter: blur(16px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
    gap: 22px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .brand img {
    width: 168px;
    height: auto;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  nav a {
    border-radius: 6px;
    padding: 10px 12px;
    color: var(--muted);
    font-weight: 750;
  }

  nav a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }

  .menu-toggle,
  .mobile-cta {
    display: none;
  }

  .menu-toggle {
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    place-items: center;
    padding: 0;
  }

  .menu-toggle span {
    display: block;
    width: 19px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transition:
      transform 160ms ease,
      opacity 160ms ease;
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 820px) {
    .header-inner {
      padding: 12px 0;
      min-height: 68px;
    }

    .menu-toggle {
      display: grid;
      margin-left: auto;
    }

    nav {
      position: absolute;
      left: 14px;
      right: 14px;
      top: calc(100% + 8px);
      display: none;
      width: auto;
      max-width: calc(100vw - 28px);
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 10px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: rgba(7, 17, 15, 0.98);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.34);
    }

    nav[data-open='true'] {
      display: grid;
    }

    nav a {
      width: 100%;
      padding: 12px;
    }

    .mobile-cta {
      display: inline-flex;
      margin-top: 4px;
    }

    .header-cta {
      display: none;
    }

    .brand img {
      width: 142px;
    }
  }

  @media (max-width: 380px) {
    .brand img {
      width: 128px;
    }
  }
</style>
