---
import settings from '../content/site/settings.json';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <a class="brand" href="/">
        <img src={settings.brand.logoLight} alt="" />
      </a>
      <p>
        {settings.footer.description}
      </p>
    </div>
    <div class="footer-links">
      {settings.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </div>
  <div class="container legal-links">
    {
      settings.footer.legalLinks.map((item) => (
        <a href={item.href} data-cookie-settings-link={item.href === '#cookie-settings' ? true : undefined}>
          {item.label}
        </a>
      ))
    }
  </div>
  <div class="container fine-print">
    <span>{settings.footer.copyright}</span>
    <span>{settings.footer.note}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: #07100f;
    padding: 44px 0 28px;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: start;
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .brand img {
    width: 170px;
    height: auto;
  }

  p {
    max-width: 520px;
    color: var(--muted);
    line-height: 1.7;
  }

  .footer-links {
    display: grid;
    gap: 12px;
    min-width: 160px;
  }

  .footer-links a {
    color: var(--muted);
    font-weight: 750;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .fine-print {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    color: rgba(236, 245, 242, 0.58);
    font-size: 0.88rem;
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: 28px;
    color: rgba(236, 245, 242, 0.68);
    font-size: 0.88rem;
    font-weight: 750;
  }

  .legal-links a:hover {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .footer-inner,
    .fine-print {
      grid-template-columns: 1fr;
      flex-direction: column;
    }

    .footer-links {
      min-width: 0;
    }
  }

  @media (max-width: 520px) {
    .site-footer {
      padding: 34px 0 24px;
    }

    .brand img {
      width: 142px;
    }
  }
</style>
