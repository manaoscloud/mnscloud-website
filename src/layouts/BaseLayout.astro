---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { alternates, defaultLocale, localeFromUrl, locales, ogLocales } from '../i18n';
import { getContent, siteShared, siteUrl } from '../lib/content';

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const locale = localeFromUrl(Astro.url);
const { settings } = getContent(locale);

const {
  title = settings.site.defaultTitle,
  description = settings.site.defaultDescription,
  noindex = false,
} = Astro.props;

const baseUrl = siteUrl();
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).toString();
const ogImageUrl = new URL(siteShared.site.ogImage, baseUrl).toString();
const alternateLinks = alternates(Astro.url.pathname).map((item) => ({
  hreflang: item.locale,
  href: new URL(item.href, baseUrl).toString(),
}));
const defaultAlternate = alternateLinks.find((item) => item.hreflang === defaultLocale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {
      locales
        .filter((item) => item !== locale)
        .map((item) => <meta property="og:locale:alternate" content={ogLocales[item]} />)
    }
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((item) => <link rel="alternate" hreflang={item.hreflang} href={item.href} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
    <link rel="icon" type="image/png" href={siteShared.brand.favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Oswald:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <CookieConsent />
  </body>
</html>
