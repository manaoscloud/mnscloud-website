---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = 'MNSCloud - Cloud, Telecom, Security, And Automation Platform',
  description = 'MNSCloud is a modular platform for telecom, hosting, monitoring, cyber security, support, CRM, and infrastructure automation.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/brand/mnscloud-placeholder-mark.svg" />
    <link rel="icon" href="/brand/mnscloud-placeholder-mark.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
